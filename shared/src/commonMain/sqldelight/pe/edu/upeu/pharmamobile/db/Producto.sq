CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

CREATE TABLE sincronizacion (
    clave TEXT NOT NULL PRIMARY KEY,
    instante INTEGER NOT NULL
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1 AND intentos < ? ORDER BY id ASC;

observarPendientes:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos < ?;

observarFallidas:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos >= ?;

insertar:
INSERT OR REPLACE INTO producto(id, nombre, precio, stock, pendiente, intentos, ultimoError)
VALUES (?, ?, ?, ?, ?, ?, ?);

sumarIntento:
UPDATE producto SET intentos = intentos + 1, ultimoError = ? WHERE id = ?;

marcarFallida:
UPDATE producto SET intentos = ?, ultimoError = ? WHERE id = ?;

reiniciarFallidas:
UPDATE producto SET intentos = 0, ultimoError = NULL WHERE pendiente = 1 AND intentos >= ?;

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto;

eliminarPorId:
DELETE FROM producto WHERE id = ?;

productoPorId:
SELECT * FROM producto WHERE id = ?;

guardarUltimaSincronizacion:
INSERT OR REPLACE INTO sincronizacion(clave, instante)
VALUES ('ultima_correcta', ?);

leerUltimaSincronizacion:
SELECT instante FROM sincronizacion WHERE clave = 'ultima_correcta';
